{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Probe Research",
  "colors": {
    "primary": "#1b1c1a",
    "light": "#eceae2",
    "dark": "#1b1c1a"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#f6f5f1",
      "dark": "#000000"
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "installation",
          "quickstart",
          "concepts"
        ],
        "icon": "flag",
        "expanded": true
      },
      {
        "group": "Setup wizard",
        "icon": "wand-magic-sparkles",
        "pages": [
          "wizard/overview",
          "wizard/install",
          "wizard/import",
          "wizard/imports",
          "wizard/settings",
          "wizard/account",
          "wizard/diagnose",
          "wizard/flags"
        ],
        "expanded": true
      },
      {
        "group": "Tracking your work",
        "icon": "flask",
        "pages": [
          "tracking/projects",
          "tracking/runs",
          "tracking/metrics",
          "tracking/artifacts",
          "tracking/datasets",
          "tracking/snapshots",
          "tracking/trajectories",
          "tracking/notes",
          "tracking/summaries",
          "tracking/papers"
        ]
      },
      {
        "group": "Python SDK",
        "icon": "python",
        "pages": [
          "sdk/quickstart",
          "sdk/reference",
          "sdk/integrations"
        ]
      },
      {
        "group": "CLI",
        "icon": "terminal",
        "pages": [
          "cli/overview",
          "cli/auth",
          "cli/commands",
          "cli/outbox"
        ]
      },
      {
        "group": "Coding agents",
        "icon": "robot",
        "pages": [
          "agents/overview",
          "agents/daemon",
          "agents/skills",
          "agents/probe-config",
          "agents/mcp",
          "agents/capture",
          "agents/statusline",
          "agents/capy"
        ]
      },
      {
        "group": "Dashboard",
        "icon": "browser",
        "pages": [
          "dashboard/overview",
          "dashboard/projects",
          "dashboard/experiments-runs",
          "dashboard/charts",
          "dashboard/data",
          "dashboard/search",
          "dashboard/assistant",
          "dashboard/workspaces"
        ]
      },
      {
        "group": "Integrations and imports",
        "icon": "right-left",
        "pages": [
          "integrations/overview",
          "integrations/wandb",
          "integrations/github",
          "integrations/benchling",
          "integrations/backfill"
        ]
      },
      {
        "group": "Deploy and operate",
        "icon": "server",
        "pages": [
          "deploy/architecture",
          "deploy/self-host"
        ]
      },
      {
        "group": "Reference",
        "icon": "book",
        "pages": [
          "reference/environment",
          "reference/troubleshooting",
          "reference/glossary"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://research.prbe.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/prbe-ai/research-os-agent"
    }
  },
  "description": "Probe Research is the system of record for a team's ML work — projects, experiments, runs, metrics, artifacts, notes and coding-agent sessions, with semantic search over all of it.",
  "seo": {},
  "redirects": [
    {
      "source": "/tracking/rules",
      "destination": "/tracking/notes"
    },
    {
      "source": "/dashboard/files",
      "destination": "/dashboard/data"
    }
  ]
}
